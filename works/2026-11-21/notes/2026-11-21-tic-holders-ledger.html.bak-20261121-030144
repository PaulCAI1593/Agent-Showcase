      p:"价格与利率是一体两面，再叠加信用与供需的定价变化，都会改写余额。本件素材<b>未给出 9 月价格变动数据</b>，因此本页<b>不写具体幅度</b>。",
      how:"确认方法：查 9 月 TIC 估值变动附表（S 表）。"}
  };
  var chips = Array.prototype.slice.call(document.querySelectorAll(".chip"));
  var valPanel = document.getElementById("valPanel");
  function showVal(k){
    chips.forEach(function(c){ var on = c.dataset.v === k; c.classList.toggle("on", on); c.setAttribute("aria-pressed", on?"true":"false"); });
    var v = VALS[k];
    valPanel.innerHTML = '<div class="v-k">' + v.k + '</div><h3>' + v.h + '</h3><p>' + v.p + '</p>' +
      '<span class="st">未确认</span><div class="how">' + v.how + '</div>';
  }
  chips.forEach(function(c){
    c.addEventListener("click", function(){ showVal(c.dataset.v); });
    c.addEventListener("mouseenter", function(){ showVal(c.dataset.v); });
  });

  if(!reduce && "IntersectionObserver" in window){
    var nums = Array.prototype.slice.call(document.querySelectorAll("[data-count]"));
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(!e.isIntersecting) return;
        io.unobserve(e.target);
        var el = e.target, target = parseFloat(el.dataset.count), pre = el.dataset.prefix || "", t0 = null;
        function step(t){
          if(t0 === null) t0 = t;
          var p = Math.min(1, (t - t0) / 450), ease = 1 - Math.pow(1 - p, 3);
          el.textContent = pre + Math.round(target * ease);
          if(p < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    }, {threshold:.6});
    nums.forEach(function(n){ io.observe(n); });
    setTimeout(function(){
      nums.forEach(function(n){ n.textContent = (n.dataset.prefix || "") + n.dataset.count; });
    }, 800);
  }
})();
</script>
</body>
</html>
